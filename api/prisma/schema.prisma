generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  code      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  classes   SchoolClass[]
}

model SchoolClass {
  id        Int       @id @default(autoincrement())
  name      String
  level     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  boardId   Int
  board     Board     @relation(fields: [boardId], references: [id])
  subjects  Subject[]

  @@unique([boardId, level])
}

model Subject {
  id        Int         @id @default(autoincrement())
  name      String
  code      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  classId   Int
  chapters  Chapter[]
  class     SchoolClass @relation(fields: [classId], references: [id])

  @@unique([classId, code])
}

model Chapter {
  id        Int        @id @default(autoincrement())
  name      String
  order     Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  subjectId Int
  subject   Subject    @relation(fields: [subjectId], references: [id])
  questions Question[]
  topics    Topic[]

  @@unique([subjectId, order])
}

model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  chapterId Int
  questions Question[]
  skills    Skill[]
  chapter   Chapter    @relation(fields: [chapterId], references: [id])
}

model Skill {
  id          Int                   @id @default(autoincrement())
  name        String
  code        String                @unique
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  topicId     Int
  questions   QuestionSkill[]
  topic       Topic                 @relation(fields: [topicId], references: [id])
  mastery     StudentSkillMastery[]
}

model Question {
  id             Int             @id @default(autoincrement())
  text           String
  difficulty     Int
  questionType   String          @default("STEP_BASED")
  expectedAnswer String?
  expectedSteps  Json?
  commonMistakes Json?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  chapterId      Int
  topicId        Int
  attempts       Attempt[]
  hints          Hint[]
  chapter        Chapter         @relation(fields: [chapterId], references: [id])
  topic          Topic           @relation(fields: [topicId], references: [id])
  skills         QuestionSkill[]
}

model QuestionSkill {
  id         Int      @id @default(autoincrement())
  weight     Float    @default(1)
  questionId Int
  skillId    Int
  question   Question @relation(fields: [questionId], references: [id])
  skill      Skill    @relation(fields: [skillId], references: [id])

  @@unique([questionId, skillId])
}

model Hint {
  id         Int      @id @default(autoincrement())
  text       String
  level      Int
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([questionId, level])
}

model Student {
  id         Int                   @id @default(autoincrement())
  name       String
  email      String?               @unique
  classLevel Int
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  attempts   Attempt[]
  mastery    StudentSkillMastery[]
}

model Attempt {
  id          Int           @id @default(autoincrement())
  status      String        @default("IN_PROGRESS")
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  studentId   Int
  questionId  Int
  question    Question      @relation(fields: [questionId], references: [id])
  student     Student       @relation(fields: [studentId], references: [id])
  steps       AttemptStep[]
}

model AttemptStep {
  id            Int      @id @default(autoincrement())
  stepNumber    Int
  studentStep   String
  isCorrect     Boolean
  mistakeType   String?
  skillCode     String?
  attemptNumber Int      @default(1)
  hintUsed      Boolean  @default(false)
  timeTakenSec  Int?
  createdAt     DateTime @default(now())
  attemptId     Int
  attempt       Attempt  @relation(fields: [attemptId], references: [id])
}

model StudentSkillMastery {
  id        Int      @id @default(autoincrement())
  mastery   Float    @default(50)
  attempts  Int      @default(0)
  correct   Int      @default(0)
  incorrect Int      @default(0)
  updatedAt DateTime @updatedAt
  studentId Int
  skillId   Int
  skill     Skill    @relation(fields: [skillId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, skillId])
}

model User {
  id                         Int                 @id @default(autoincrement())
  email                      String              @unique
  passwordHash               String
  firstName                  String
  lastName                   String
  systemRole                 SystemRole          @default(EMPLOYEE)
  status                     UserStatus          @default(ACTIVE)
  lastLoginAt                DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  createdAssessments         Assessment[]
  sessions                   AuthSession[]
  approvedCourseMappings     CourseCompetency[]
  profile                    EmployeeProfile?
  reviewedGeneratedQuestions GeneratedQuestion[] @relation("GeneratedQuestionReviewedBy")
  uploadedTrainingMaterials  TrainingMaterial[]  @relation("TrainingMaterialUploadedBy")

  @@index([email])
  @@index([systemRole])
}

model EmployeeProfile {
  id                       Int                    @id @default(autoincrement())
  userId                   Int                    @unique
  employeeCode             String?                @unique
  designation              String
  cadre                    String?
  currentAssignment        String?
  educationalQualification String?
  experienceYears          Float                  @default(0)
  departmentId             Int?
  jobRoleId                Int?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  assessmentAttempts       AssessmentAttempt[]
  competencyHistory        CompetencyHistory[]
  recommendations          CourseRecommendation[]
  competencies             EmployeeCompetency[]
  department               Department?            @relation(fields: [departmentId], references: [id])
  jobRole                  JobRole?               @relation(fields: [jobRoleId], references: [id])
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments              TrainingEnrollment[]

  @@index([departmentId])
  @@index([jobRoleId])
}

model Department {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  name        String
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  employees   EmployeeProfile[]
  jobRoles    JobRole[]
}

model JobRole {
  id           Int                         @id @default(autoincrement())
  code         String                      @unique
  name         String
  description  String?
  level        Int?
  isActive     Boolean                     @default(true)
  departmentId Int?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  employees    EmployeeProfile[]
  department   Department?                 @relation(fields: [departmentId], references: [id])
  requirements RoleCompetencyRequirement[]

  @@index([departmentId])
}

model CompetencyDomain {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  competencies Competency[]
}

model Competency {
  id                   Int                          @id @default(autoincrement())
  code                 String                       @unique
  name                 String
  description          String?
  domainId             Int
  parentCompetencyId   Int?
  proficiencyScaleMin  Int                          @default(1)
  proficiencyScaleMax  Int                          @default(100)
  isActive             Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  assessments          Assessment[]
  assessmentAttempts   AssessmentAttempt[]
  questionBank         AssessmentQuestionBankItem[]
  domain               CompetencyDomain             @relation(fields: [domainId], references: [id])
  parentCompetency     Competency?                  @relation("CompetencyHierarchy", fields: [parentCompetencyId], references: [id])
  childCompetencies    Competency[]                 @relation("CompetencyHierarchy")
  historyRecords       CompetencyHistory[]
  courseMappings       CourseCompetency[]
  prerequisites        CoursePrerequisite[]
  recommendations      CourseRecommendation[]
  employeeCompetencies EmployeeCompetency[]
  generatedQuestions   GeneratedQuestion[]
  roleRequirements     RoleCompetencyRequirement[]
  trainingMaterials    TrainingMaterial[]

  @@index([domainId])
  @@index([parentCompetencyId])
}

model RoleCompetencyRequirement {
  id              Int        @id @default(autoincrement())
  jobRoleId       Int
  competencyId    Int
  requiredScore   Float
  priorityWeight  Float      @default(1.0)
  isMandatory     Boolean    @default(true)
  minimumScore    Float?
  sourceReference String?
  approvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  competency      Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  jobRole         JobRole    @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@unique([jobRoleId, competencyId])
  @@index([jobRoleId])
  @@index([competencyId])
}

model EmployeeCompetency {
  id                Int             @id @default(autoincrement())
  employeeProfileId Int
  competencyId      Int
  currentScore      Float           @default(0)
  confidence        Float           @default(0.5)
  evidenceCount     Int             @default(0)
  lastEvaluatedAt   DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  competency        Competency      @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, competencyId])
  @@index([employeeProfileId])
  @@index([competencyId])
}

model CompetencyHistory {
  id                Int                         @id @default(autoincrement())
  employeeProfileId Int
  competencyId      Int
  previousScore     Float
  newScore          Float
  confidence        Float                       @default(0.5)
  changeReason      String?
  sourceType        CompetencyHistorySourceType @default(DIAGNOSTIC_ASSESSMENT)
  sourceId          String?
  createdAt         DateTime                    @default(now())
  competency        Competency                  @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile             @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId])
  @@index([competencyId])
  @@index([createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           Int
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model Assessment {
  id               Int                 @id @default(autoincrement())
  title            String
  description      String?
  type             AssessmentType      @default(DIAGNOSTIC)
  status           AssessmentStatus    @default(PUBLISHED)
  competencyId     Int?
  createdByUserId  Int?
  timeLimitMinutes Int?
  questionCount    Int                 @default(10)
  passingScore     Float?
  adaptiveEnabled  Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  competency       Competency?         @relation(fields: [competencyId], references: [id])
  createdByUser    User?               @relation(fields: [createdByUserId], references: [id])
  attempts         AssessmentAttempt[]

  @@index([competencyId])
  @@index([type])
  @@index([status])
}

model AssessmentQuestionBankItem {
  id               Int                       @id @default(autoincrement())
  competencyId     Int
  questionText     String
  questionType     String                    @default("MCQ")
  difficulty       QuestionDifficulty        @default(MEDIUM)
  options          Json
  correctOption    String
  explanation      String
  sourceType       String                    @default("CURATED_FRAMEWORK")
  sourceReference  String?
  isActive         Boolean                   @default(true)
  isVerified       Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  sourceMaterialId Int?
  answerAttempts   AssessmentAnswerAttempt[]
  competency       Competency                @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  sourceMaterial   TrainingMaterial?         @relation(fields: [sourceMaterialId], references: [id])
  generatedSource  GeneratedQuestion?        @relation("GeneratedQuestionQuestionBankItem")

  @@index([competencyId])
  @@index([difficulty])
  @@index([isActive])
  @@index([sourceMaterialId])
}

model AssessmentAttempt {
  id                     Int                       @id @default(autoincrement())
  assessmentId           Int?
  employeeProfileId      Int
  competencyId           Int
  status                 AttemptStatus             @default(IN_PROGRESS)
  startedAt              DateTime                  @default(now())
  completedAt            DateTime?
  currentQuestionIndex   Int                       @default(0)
  currentDifficulty      QuestionDifficulty        @default(MEDIUM)
  totalQuestions         Int                       @default(10)
  correctAnswers         Int                       @default(0)
  rawScore               Float                     @default(0.0)
  initialCompetencyScore Float?
  finalCompetencyScore   Float?
  durationSeconds        Int?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  answers                AssessmentAnswerAttempt[]
  assessment             Assessment?               @relation(fields: [assessmentId], references: [id])
  competency             Competency                @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  employeeProfile        EmployeeProfile           @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId])
  @@index([competencyId])
  @@index([status])
}

model AssessmentAnswerAttempt {
  id                     Int                        @id @default(autoincrement())
  assessmentAttemptId    Int
  questionId             Int
  selectedOption         String
  isCorrect              Boolean
  difficulty             QuestionDifficulty
  responseTimeMs         Int?
  attemptSequence        Int
  estimatedMasteryBefore Float?
  estimatedMasteryAfter  Float?
  answeredAt             DateTime                   @default(now())
  assessmentAttempt      AssessmentAttempt          @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  question               AssessmentQuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([assessmentAttemptId])
  @@index([questionId])
}

model CourseProvider {
  id           Int             @id @default(autoincrement())
  code         String          @unique
  name         String
  providerType String          @default("EXTERNAL_PLATFORM")
  baseUrl      String?
  status       ProviderStatus  @default(ACTIVE)
  capabilities Json?
  lastSyncAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  courses      Course[]
  syncRuns     CourseSyncRun[]

  @@index([code])
  @@index([status])
}

model Course {
  id                 Int                    @id @default(autoincrement())
  providerId         Int
  externalId         String
  title              String
  description        String?
  providerName       String
  durationMinutes    Int                    @default(60)
  language           String                 @default("English")
  difficultyLevel    CourseDifficulty       @default(BEGINNER)
  difficultySource   DifficultySource       @default(PROVIDER_METADATA)
  courseUrl          String?
  thumbnailUrl       String?
  learningOutcomes   Json?
  tags               Json?
  prerequisitesText  String?
  isActive           Boolean                @default(true)
  sourceUpdatedAt    DateTime?
  lastSyncedAt       DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  provider           CourseProvider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  competencyMappings CourseCompetency[]
  prerequisites      CoursePrerequisite[]   @relation("CoursePrerequisites")
  requiredByCourses  CoursePrerequisite[]   @relation("PrerequisiteCourse")
  recommendations    CourseRecommendation[]
  enrollments        TrainingEnrollment[]

  @@unique([providerId, externalId])
  @@index([providerId])
  @@index([difficultyLevel])
  @@index([isActive])
}

model CourseCompetency {
  id                 Int           @id @default(autoincrement())
  courseId           Int
  competencyId       Int
  relevanceScore     Float
  mappingMethod      MappingMethod @default(SEMANTIC)
  mappingReliability Float         @default(0.8)
  evidence           String?
  status             MappingStatus @default(APPROVED)
  approvedByUserId   Int?
  approvedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  approvedByUser     User?         @relation(fields: [approvedByUserId], references: [id])
  competency         Competency    @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  course             Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, competencyId])
  @@index([courseId])
  @@index([competencyId])
  @@index([status])
  @@index([relevanceScore])
}

model CoursePrerequisite {
  id                       Int         @id @default(autoincrement())
  courseId                 Int
  prerequisiteCourseId     Int?
  prerequisiteCompetencyId Int?
  minimumCompetencyScore   Float?
  createdAt                DateTime    @default(now())
  course                   Course      @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCompetency   Competency? @relation(fields: [prerequisiteCompetencyId], references: [id])
  prerequisiteCourse       Course?     @relation("PrerequisiteCourse", fields: [prerequisiteCourseId], references: [id])

  @@index([courseId])
  @@index([prerequisiteCourseId])
  @@index([prerequisiteCompetencyId])
}

model CourseSyncRun {
  id           Int            @id @default(autoincrement())
  providerId   Int
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  status       SyncStatus     @default(SUCCESS)
  itemsFetched Int            @default(0)
  itemsCreated Int            @default(0)
  itemsUpdated Int            @default(0)
  itemsFailed  Int            @default(0)
  errorSummary String?
  provider     CourseProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([startedAt])
}

model CourseRecommendation {
  id                  Int             @id @default(autoincrement())
  employeeProfileId   Int
  courseId            Int
  competencyId        Int
  recommendationScore Float
  rankingPosition     Int
  reasons             Json
  preCompetencyScore  Float?
  postCompetencyScore Float?
  outcomeImprovement  Float?
  recommendedAt       DateTime        @default(now())
  acceptedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  competency          Competency      @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  course              Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeProfile     EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId])
  @@index([courseId])
  @@index([competencyId])
  @@index([recommendedAt])
}

model TrainingEnrollment {
  id                Int              @id @default(autoincrement())
  employeeProfileId Int
  courseId          Int
  status            EnrollmentStatus @default(ENROLLED)
  completionSource  EnrollmentSource @default(LOCAL_PLATFORM_EVENT)
  progressPercent   Float            @default(0.0)
  score             Float?
  enrolledAt        DateTime         @default(now())
  completedAt       DateTime?
  updatedAt         DateTime         @updatedAt
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, courseId])
  @@index([employeeProfileId])
  @@index([courseId])
  @@index([status])
}

model TrainingMaterial {
  id                 Int                          @id @default(autoincrement())
  title              String
  description        String?
  originalFileName   String
  storedFileName     String
  storagePath        String
  mimeType           String
  fileSizeBytes      Int
  checksum           String?
  status             MaterialProcessingStatus     @default(UPLOADED)
  processingError    String?
  pageCount          Int?
  language           String                       @default("English")
  extractedText      String?
  competencyId       Int?
  uploadedByUserId   Int
  processedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  questionBankItems  AssessmentQuestionBankItem[]
  generatedQuestions GeneratedQuestion[]
  chunks             MaterialChunk[]
  competency         Competency?                  @relation(fields: [competencyId], references: [id])
  uploadedBy         User                         @relation("TrainingMaterialUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([uploadedByUserId])
  @@index([competencyId])
  @@index([status])
  @@index([createdAt])
}

model MaterialChunk {
  id                 Int                 @id @default(autoincrement())
  materialId         Int
  chunkIndex         Int
  pageNumber         Int?
  text               String
  tokenCount         Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  generatedQuestions GeneratedQuestion[]
  material           TrainingMaterial    @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
  @@index([materialId])
  @@index([pageNumber])
}

model GeneratedQuestion {
  id                 Int                           @id @default(autoincrement())
  materialId         Int
  sourceChunkId      Int?
  competencyId       Int
  questionText       String
  questionType       String                        @default("MCQ")
  difficulty         QuestionDifficulty            @default(MEDIUM)
  options            Json
  correctOption      String
  explanation        String
  sourcePage         Int?
  sourceExcerpt      String?
  generatorProvider  String?
  generatorModel     String?
  confidence         Float?
  status             GeneratedQuestionReviewStatus @default(PENDING)
  reviewNotes        String?
  reviewedByUserId   Int?
  reviewedAt         DateTime?
  questionBankItemId Int?                          @unique
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  competency         Competency                    @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  material           TrainingMaterial              @relation(fields: [materialId], references: [id], onDelete: Cascade)
  questionBankItem   AssessmentQuestionBankItem?   @relation("GeneratedQuestionQuestionBankItem", fields: [questionBankItemId], references: [id])
  reviewedBy         User?                         @relation("GeneratedQuestionReviewedBy", fields: [reviewedByUserId], references: [id])
  sourceChunk        MaterialChunk?                @relation(fields: [sourceChunkId], references: [id])

  @@index([materialId])
  @@index([sourceChunkId])
  @@index([competencyId])
  @@index([status])
  @@index([reviewedByUserId])
}

enum SystemRole {
  EMPLOYEE
  TRAINER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompetencyHistorySourceType {
  DIAGNOSTIC_ASSESSMENT
  TRAINING_ASSESSMENT
  MANUAL_APPROVED_ADJUSTMENT
  MIGRATION
  SYSTEM_RECALCULATION
}

enum MaterialProcessingStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum GeneratedQuestionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssessmentType {
  DIAGNOSTIC
  TRAINING
  POST_TRAINING
  PRACTICE
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXPIRED
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  NOT_CONFIGURED
  ERROR
}

enum CourseDifficulty {
  FOUNDATIONAL
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum DifficultySource {
  PROVIDER_METADATA
  AI_ESTIMATED
  MANUAL
}

enum MappingMethod {
  SEMANTIC
  PROVIDER_METADATA
  LLM_ASSISTED
  HUMAN_OVERRIDE
}

enum MappingStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum EnrollmentSource {
  LOCAL_PLATFORM_EVENT
  OFFICIAL_PROVIDER_SYNC
}
